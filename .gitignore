# Python bytecode and test/type-check caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments and local configuration/secrets
.venv/
venv/
env/
.env
.env.*
!.env.example

# Build outputs and local run artifacts
build/
dist/
*.egg-info/
*.tar.gz
test-results/
playwright-report/
blob-report/

# Logs
*.log

# Runtime research artifact (may contain tender, supplier, ERP and mail content)
evidence.json
dev/runs/*.json
dev/runs/*.jsonl
dev/runs/sandbox/
dev/runs/optimization-*/
dev/evals/bundles/
.atira/

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
